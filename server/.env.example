# BharatSales API (server) environment variables.
# Copy to server/.env for local development. Placeholder values only:
# never commit real secrets. Production values live in Render (render.yaml).

# --- Runtime ---------------------------------------------------------------
# development | production | test
NODE_ENV=development
PORT=6002

# --- Database (required in production) ------------------------------------
# Must be a replica set: orders, dispatch and collections use transactions.
# Local docker-compose Mongo: mongodb://localhost:27017/bharatsales?replicaSet=rs0
MONGODB_URI=mongodb://localhost:27017/bharatsales?replicaSet=rs0

# --- Auth (required) --------------------------------------------------------
# Signs the 15-minute access tokens. Min 32 characters in production or the
# API refuses to start. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Optional and currently UNUSED by the API: refresh tokens are opaque random
# values stored hashed server-side. Kept only for older deploy configs.
JWT_REFRESH_SECRET=

# --- HTTP ------------------------------------------------------------------
# Comma-separated browser origins allowed by CORS (the web dashboard / PWA).
# Unset: any origin in development, NO cross-origin browser access in production.
CORS_ORIGINS=http://localhost:6003,http://localhost:6001
# Express "trust proxy": hop count, true/false, or a proxy list. Default 1
# (one reverse proxy, e.g. Render). Must match the deployment so rate limits
# and audit logs see the real client IP.
TRUST_PROXY=1
# Public URL of the web dashboard, used for links in emails
# (verify email, reset password, invitations).
FRONTEND_URL=http://localhost:6003

# --- Uploads ----------------------------------------------------------------
# gridfs (default, photos stored in MongoDB) | local (server/uploads on disk,
# lost on every Render deploy).
STORAGE_DRIVER=gridfs

# --- Email / SMS (optional) -------------------------------------------------
# Brevo transactional email + SMS. Without BREVO_API_KEY emails are only logged.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=BharatSales AI
BREVO_SMS_SENDER=
# Read but has NO effect: SMS OTP delivery is not implemented (OTPs are emailed).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Development only -------------------------------------------------------
# Mounts the mock Google/Microsoft SSO endpoints. Ignored when NODE_ENV=production.
MOCK_SSO_ENABLED=false

# --- Seed scripts -----------------------------------------------------------
# NOTE: the seed scripts do NOT load this file; pass these on the command line.
# pnpm --filter @bharatsales/api seed / seed:platform-admin / seed:demo-data
# refuse to run with NODE_ENV=production unless this is "true". Never set it
# on the running server.
ALLOW_PROD_SEED=false
# seed:platform-admin creates the platform (Super Admin) account from these.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
# seed:demo-data targets the organisation of this admin user.
ADMIN_EMAIL=
