# BharatSales AI - environment variables (placeholder values only).
#
# Each app reads its own file:
#   apps/api/.env        -> see apps/api/.env.example (full list with notes)
#   apps/web/.env.local  -> see apps/web/.env.example
#   apps/field-pwa/.env.local -> see apps/field-pwa/.env.example
#   apps/mobile/.env     -> see apps/mobile/.env.example (eas.json for APK builds)
# docker-compose.yml reads JWT_SECRET, JWT_REFRESH_SECRET, CORS_ORIGINS,
# VITE_API_URL and VITE_FIELD_PWA_URL from a root .env file. It runs the API
# with NODE_ENV=production, so JWT_SECRET must be 32+ characters there.

# ---------------------------------------------------------------- API ---
NODE_ENV=development
PORT=6002
# Must be a replica set (transactions).
MONGODB_URI=mongodb://localhost:27017/bharatsales?replicaSet=rs0
# Required. Min 32 characters in production. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Optional, currently unused by the API (refresh tokens are opaque).
JWT_REFRESH_SECRET=
# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:6003,http://localhost:6001
# Reverse-proxy hops in front of the API (Render / nginx = 1).
TRUST_PROXY=1
# Web dashboard URL used in email links.
FRONTEND_URL=http://localhost:6003
# gridfs (default) | local
STORAGE_DRIVER=gridfs
# Optional Brevo email/SMS/WhatsApp. Without a key, emails are only logged.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=BharatSales AI
BREVO_SMS_SENDER=
# No effect: SMS OTP delivery is not implemented.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Development only; ignored in production.
MOCK_SSO_ENABLED=false
# Seed scripts only (they do not read .env files; pass on the command line).
# They refuse NODE_ENV=production unless ALLOW_PROD_SEED is "true".
ALLOW_PROD_SEED=false
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
ADMIN_EMAIL=

# ------------------------------------------------ Web / PWA (Vite) ---
# Inlined at build time. Base URL of the API (no /api/v1 suffix).
VITE_API_URL=http://localhost:6002
VITE_FIELD_PWA_URL=http://localhost:6001
VITE_WHATSAPP_NUMBER=
VITE_CONTACT_EMAIL=

# ---------------------------------------------------- Mobile (Expo) ---
# On a physical phone use your computer's LAN IP, e.g. http://192.168.1.10:6002
EXPO_PUBLIC_API_URL=http://localhost:6002
