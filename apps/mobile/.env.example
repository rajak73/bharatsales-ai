# Mobile app (Expo). Copy to apps/mobile/.env for `pnpm --filter @bharatsales/mobile dev`.
# EXPO_PUBLIC_* values are inlined into the JS bundle and are public: no secrets.
# APK builds do NOT use this file: they take EXPO_PUBLIC_API_URL from eas.json.

# Base URL of the BharatSales API, no /api/v1 suffix (read by @bharatsales/api-client).
# A phone cannot reach "localhost" on your computer: use its LAN IP, e.g.
# http://192.168.1.10:6002 (Android emulator: http://10.0.2.2:6002).
EXPO_PUBLIC_API_URL=http://192.168.1.10:6002
