# Field PWA (Vite). Copy to apps/field-pwa/.env.local for local development.
# VITE_* values are inlined at BUILD time and are public: never put secrets here.

# Base URL of the BharatSales API, no /api/v1 suffix (read by @bharatsales/api-client).
# Production builds get https://bharatsales-ai.onrender.com from .env.production;
# unset in dev, the api-client falls back to http://127.0.0.1:6002.
VITE_API_URL=http://localhost:6002
