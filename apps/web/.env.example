# Web dashboard (Vite). VITE_* values are inlined at BUILD time and are public:
# never put secrets here. Copy to apps/web/.env.local.

# Base URL of the BharatSales API, no /api/v1 suffix (read by @bharatsales/api-client).
# Production: https://bharatsales-ai.onrender.com
VITE_API_URL=http://localhost:6002
# Where the "Field PWA" sidebar link points for Sales Representatives.
VITE_FIELD_PWA_URL=http://localhost:6001
# Optional: WhatsApp number (country code + number, digits only, e.g. 919000012345)
# for the floating chat button on the public site. Leave empty to hide the button.
VITE_WHATSAPP_NUMBER=
# Optional: contact email shown on the public marketing pages.
VITE_CONTACT_EMAIL=
